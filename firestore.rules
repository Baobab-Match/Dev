rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /countries/{countryId} {
      allow read: if true;
      allow write: if false;
    }

    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // 가입: 기업 회원만 bizNo 형식 검증, 나머지 타입은 통과
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email is string
        && (request.resource.data.type != 'company'
            || (request.resource.data.bizNo is string
                && request.resource.data.bizNo.matches('^[0-9]{10}$')));

      // 수정(즐겨찾기 등): 본인 문서면 허용. 보호할 필드만 "있을 때" 검사.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.favorites is list
        && request.resource.data.favorites.size() <= 100
        && request.resource.data.email == resource.data.email
        && request.resource.data.type == resource.data.type
        && (!('bizNo' in resource.data)
            || request.resource.data.bizNo == resource.data.bizNo);
    }
  }
}